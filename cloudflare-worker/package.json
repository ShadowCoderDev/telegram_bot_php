{
  "name": "telegram-shop-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply shop --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run test/unit.test.ts test/repositories.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.141.0"
  }
}
