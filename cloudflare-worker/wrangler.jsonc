{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-shop-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Deploy with `npm run deploy` (scripts/deploy.mjs) or the "Deploy to Cloudflare" button.
  // The Worker creates its own tables on first use and registers its Telegram webhook when its URL
  // is opened, so nothing in this file needs editing. Secrets: BOT_TOKEN, WEBHOOK_SECRET.
  "vars": {
    // Optional: numeric chat ids of admins, comma separated. Sellers can instead send
    // `/claim <WEBHOOK_SECRET>` to their bot to become admin.
    "ADMIN_CHAT_IDS": "",
    "TELEGRAM_API_BASE": "https://api.telegram.org"
  },

  // Replaces MySQL. The database is created on first deploy and its id filled in automatically.
  "d1_databases": [{ "binding": "DB", "database_name": "shop", "migrations_dir": "migrations" }],

  // Migration files are bundled as text so the Worker can apply them itself (src/db/migrate.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]

  // Optional receipt archive in R2 (needs R2 enabled on the account, which asks for a payment method):
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "shop-files" }]
}
