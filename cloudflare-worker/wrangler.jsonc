{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-shop-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Non-secret configuration. Secrets (BOT_TOKEN, WEBHOOK_SECRET) are set with
  // `wrangler secret put` (production) or in .dev.vars (local).
  "vars": {
    "ADMIN_CHAT_IDS": "2020715168",
    "TELEGRAM_API_BASE": "https://api.telegram.org"
  },

  // Replaces MySQL. Create with: wrangler d1 create shop  → paste the id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "shop", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],

  // Replaces the local uploads/ folder. Create with: wrangler r2 bucket create shop-files
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "shop-files" }
  ]
}
