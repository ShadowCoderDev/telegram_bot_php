{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-shop-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Deploy with `npm run deploy` (scripts/deploy.mjs). The Worker creates its own tables on first use
  // and registers its Telegram webhooks when its URL is opened, so nothing here needs editing.
  // Secrets – SaaS platform: PLATFORM_BOT_TOKEN, MASTER_KEY (32+ chars, never change it);
  //           the owner's own shop (optional): BOT_TOKEN, WEBHOOK_SECRET.
  "vars": {
    // Optional: numeric chat ids of admins, comma separated. Sellers can instead send
    // `/claim <WEBHOOK_SECRET>` to their bot to become admin.
    "ADMIN_CHAT_IDS": "",
    "TELEGRAM_API_BASE": "https://api.telegram.org"
  },

  // Replaces MySQL. The database is created on first deploy and its id filled in automatically.
  "d1_databases": [{ "binding": "DB", "database_name": "shop", "migrations_dir": "migrations" }],

  // Migration files are bundled as text so the Worker can apply them itself (src/db/migrate.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // On the hour: subscription expiry reminders to sellers, retention purge, capacity alarm.
  // At :15, :30, :45: appointment reminders to customers (src/reminders.ts). Keep the second
  // string in step with QUARTER_CRON in src/index.ts.
  "triggers": { "crons": ["0 * * * *", "15,30,45 * * * *"] }

  // Optional receipt archive in R2 (needs R2 enabled on the account, which asks for a payment method):
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "shop-files" }]
}
